--============= HWID =============
local function getHWID()
    local id = ""
    pcall(function()
        id = game:GetService("RbxAnalyticsService"):GetClientId()
    end)
    if id == "" and gethwid then
        pcall(function() id = gethwid() end)
    end
    if id == "" then
        id = tostring(game.Players.LocalPlayer.UserId) .. "_" .. game.Players.LocalPlayer.Name
    end
    return id
end

local MY_HWID = getHWID()

--============= LƯU / ĐỌC DỮ LIỆU =============
-- Format: key|hwid|activated_at|uses_left
-- Lưu nhiều key cùng lúc (dùng xuống dòng \n phân tách)

local function loadAllData()
    local data = {}
    if isfile and isfile(CONFIG.SAVE_FILE) then
        local ok, raw = pcall(readfile, CONFIG.SAVE_FILE)
        if ok and raw then
            for line in string.gmatch(raw, "([^\n]+)") do
                local parts = {}
                for p in string.gmatch(line, "([^|]+)") do
                    table.insert(parts, p)
                end
                if #parts >= 4 then
                    data[parts[1]] = {
                        hwid         = parts[2],
                        activated_at = tonumber(parts[3]) or 0,
                        uses_left    = tonumber(parts[4]) or 0,
                    }
                end
            end
        end
    end
    return data
end

local function saveAllData(data)
    if not writefile then return end
    local lines = {}
    for k, v in pairs(data) do
        table.insert(lines, table.concat({
            k, v.hwid, tostring(v.activated_at), tostring(v.uses_left)
        }, "|"))
    end
    pcall(writefile, CONFIG.SAVE_FILE, table.concat(lines, "\n"))
end

--============= CHECK KEY =============
local function checkKey(key)
    -- 1. Kiểm tra key có trong danh sách không
    local info = CONFIG.KEYS[key]
    if not info then
        return false, "❌ Key không đúng hoặc không tồn tại!"
    end

    -- 2. Đọc dữ liệu
    local allData = loadAllData()
    local rec = allData[key]

    -- 3. Nếu chưa có record → kích hoạt lần đầu
    if not rec then
        local now = os.time()
        allData[key] = {
            hwid         = MY_HWID,
            activated_at = now,
            uses_left    = info.maxUses - 1,  -- Trừ 1 lượt cho lần này
        }
        saveAllData(allData)
        local hrs = math.floor(info.duration / 3600)
        return true, string.format(
            "✅ Kích hoạt [%s] — Hạn %dh — Còn %d lượt",
            info.label, hrs, info.maxUses - 1
        )
    end

    -- 4. Check HWID
    if rec.hwid ~= MY_HWID then
        return false, "🔒 Key đã khóa trên máy khác!"
    end

    -- 5. Check thời hạn
    local now = os.time()
    local elapsed = now - rec.activated_at
    local remain  = info.duration - elapsed

    if remain <= 0 then
        return false, "⏰ Key đã hết hạn!"
    end

    -- 6. Check số lượt
    if rec.uses_left <= 0 then
        return false, "🚫 Key đã hết lượt sử dụng!"
    end

    -- 7. Trừ 1 lượt
    rec.uses_left = rec.uses_left - 1
    allData[key] = rec
    saveAllData(allData)

    local d = math.floor(remain / 86400)
    local h = math.floor((remain % 86400) / 3600)
    local m = math.floor((remain % 3600) / 60)

    return true, string.format(
        "✅ Key [%s] — Còn %dd %dh %dm — Còn %d lượt",
        info.label, d, h, m, rec.uses_left
    )
end

